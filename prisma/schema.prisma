generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ContentType {
  SERVICE
  TESTIMONIAL
  FAQ
  BLOG
  PLATFORM
  INSTRUCTOR
  VIDEO
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Hizmetler/Katalog/Takvim'de kullanılan sabit 6 kategori. Canlı sitedeki
// katalog filtresi, kart animasyon sistemi ve metod panelleri bu 6 kategoriye
// göre tasarlandığı için sabit tutulur (bkz. proje mimari kararı).
enum TrainingCategory {
  AI
  LIDER
  SOFT
  IK
  ALIM
  KOC
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  source    String     @default("website")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ContentItem {
  id        String      @id @default(cuid())
  type      ContentType
  title     String
  subtitle  String?
  body      String?
  category  String?
  order     Int         @default(0)
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Blog & SEO fazı (additive) — sadece type:BLOG kayıtlarında kullanılır,
  // diğer tiplerde (SERVICE/TESTIMONIAL/FAQ) null kalır ve hiçbir şeyi bozmaz.
  slug            String?   @unique
  excerpt         String?
  content         String?
  coverImage      String?
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
}

// Canlı sitedeki (rectra-site) bölümleri temsil eder. Admin panelindeki
// "Süper Admin · Site Kontrolü" ekranı bu tabloyu düzenler; canlı site
// /api/sections/public üzerinden bu veriyi çekip kendi içeriğine uygular.
// NOT: Bu model her zaman ADDITIVE değişir (yeni alan eklenir, asla mevcut
// alan silinmez/tipi değiştirilmez) — mevcut veri hiçbir fazda kaybolmaz.
model SiteSection {
  id        String   @id @default(cuid())
  key       String   @unique
  icon      String
  name      String
  color     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Açık Eğitim Takvimi'ndeki kartlar. Canlı site /api/calendar/public'ten
// published:true olanları tarihe göre çekip render eder.
model CalendarEvent {
  id        String           @id @default(cuid())
  title     String
  category  TrainingCategory
  date      DateTime
  duration  String
  location  String
  certBadge String           @default("Sertifikalı")
  hot       Boolean          @default(false)
  seatText  String           @default("Kontenjan açık")
  ctaUrl    String           @default("#teklif")
  order     Int              @default(0)
  published Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Katalog modalındaki eğitim listesi (önceden index.html'de sabit kodlu
// TRAININGS dizisiydi). Canlı site /api/catalog/public'ten çekip katalog
// motorunu (filtre/arama/sepet) bu veriyle besler.
model CatalogItem {
  id        String           @id @default(cuid())
  title     String
  category  TrainingCategory
  duration  String
  format    String
  level     String
  order     Int              @default(0)
  published Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Süper Admin · Site Kontrolü'nden serbestçe eklenen yeni ana sayfa
// bölümleri. Sabit 14 bölümün aksine tamamen admin tarafından yaratılır ve
// silinebilir. Canlı sitede "teklif" bölümünden önceki custom-sections mount
// noktasına, published sırasına göre render edilir.
model CustomSection {
  id        String   @id @default(cuid())
  title     String
  body      String
  icon      String   @default("✨")
  color     String   @default("#0FA99A")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// "Murat AI Asistan" pazar analizi otomasyonu (PROJECT_BRIEF Bölüm 6.1/8).
// 3 günde bir çalışan zamanlanmış görev; rakip/arama-talebi/AI-alıntı verisini
// (OpenRush) ve genel web aramasını kullanarak kanıta dayalı bir blog taslağı
// üretir ve buraya PENDING olarak düşer. Murat admin panelden inceleyip
// Yayınla derse gerçek bir BLOG ContentItem'a dönüşür; hiçbir öneri onay
// almadan siteye çıkmaz.
model ContentSuggestion {
  id         String           @id @default(cuid())
  title      String
  slug       String?
  excerpt    String?
  content    String
  category   String?
  evidence   Json
  status     SuggestionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?

  // Görsel & sosyal genişleme fazı (additive) — otomasyon görevi Canva ile
  // ürettiği kapak görselini burada base64 data URI olarak taşır. Onaylanınca
  // ContentItem.coverImage'a aynen aktarılır. Eski öneriler için null kalır.
  coverImage String?
}

// Web sitesinde ziyaretçiye ilk girişte gösterilen tıklanabilir banner pop-up.
// Aynı anda sadece bir kayıt "active" olabilir; canlı site sadece aktif olanı
// çeker. Geçmiş kayıtlar silinmeden pasif bırakılabilir (arşiv/tekrar kullanım).
model PopupBanner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String
  altText   String?
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==== Eğitim İhtiyaç Analizi (Training Needs Analysis) ====
// Firmaların yetkinlik setleri ve davranış göstergeleri üzerinden mevcut/hedef
// seviye girip anlık bir açık (gap) analizi + önerilen eğitim çıktısı aldığı
// özellik. Competency/BehaviorIndicator admin'den yönetilen taksonomi;
// NeedsAnalysis her bir doldurulmuş formun kaydıdır ve aynı zamanda bir
// Lead olarak da CRM'e düşer (leadId ile ilişkilendirilir, ayrı tutulur ki
// Lead modeline dokunmadan additive kalsın).
model Competency {
  id         String              @id @default(cuid())
  name       String
  category   TrainingCategory
  order      Int                 @default(0)
  active     Boolean             @default(true)
  indicators BehaviorIndicator[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model BehaviorIndicator {
  id           String     @id @default(cuid())
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  competencyId String
  text         String
  order        Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

model NeedsAnalysis {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  contactEmail String
  contactPhone String?
  responses    Json
  summary      String?
  recommended  Json?
  leadId       String?
  createdAt    DateTime @default(now())
}
