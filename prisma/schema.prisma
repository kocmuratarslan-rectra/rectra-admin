generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ContentType {
  SERVICE
  TESTIMONIAL
  FAQ
  BLOG
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  source    String     @default("website")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ContentItem {
  id        String      @id @default(cuid())
  type      ContentType
  title     String
  subtitle  String?
  body      String?
  category  String?
  order     Int         @default(0)
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Canlı sitedeki (rectra-site) bölümleri temsil eder. Admin panelindeki
// "Süper Admin · Site Kontrolü" ekranı bu tabloyu düzenler; canlı site
// /api/sections/public üzerinden bu veriyi çekip kendi içeriğine uygular.
// NOT: Bu model her zaman ADDITIVE değişir (yeni alan eklenir, asla mevcut
// alan silinmez/tipi değiştirilmez) — mevcut veri hiçbir fazda kaybolmaz.
model SiteSection {
  id        String   @id @default(cuid())
  key       String   @unique
  icon      String
  name      String
  color     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
